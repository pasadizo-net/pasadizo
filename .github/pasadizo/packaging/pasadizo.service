[Unit]
Description=Pasadizo service
Documentation=https://github.com/pasadizo-net/pasadizo
After=network.target nss-lookup.target network-online.target

[Service]
StateDirectory=pasadizo
ExecStart=/usr/bin/pasadizo -D /var/lib/pasadizo -C /etc/pasadizo run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
LimitNOFILE=infinity

[Install]
WantedBy=multi-user.target
